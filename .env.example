# ============================================================
# 千图AI · 手持商品 MVP · 环境变量
# 复制本文件为 .env.local 后修改取值
# ============================================================

# 是否启用 MSW Mock(true = 开发模式,false = 真实 backend)
# 开发联调前端时 = true · 开发联调后端时 / 上线前 = false
VITE_USE_MOCK=true

# 真实 backend API base URL(VITE_USE_MOCK=false 时使用)
# 千图AI 后端通知地址后填这里
VITE_API_BASE_URL=https://api.qiantu.ai/v1/handheld

# 用户标签(用于埋点 · 影响"使用率"指标计算)
# ecommerce | creator | other
VITE_USER_TYPE=ecommerce
